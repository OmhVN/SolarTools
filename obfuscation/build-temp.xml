<?xml version="1.0" encoding="UTF-8"?>
<project name="SolarWorth-yGuard-Obfuscation" default="yguard" basedir="..">
    <property name="input.jar" value="${basedir}/obfuscation/output/temp/plugin-only.jar"/>
    <property name="output.jar" value="${basedir}/obfuscation/output/temp/plugin-obfuscated.jar"/>
    <property name="yguard.jar" value="${basedir}/obfuscation/libs/yguard.jar"/>
    
    <target name="yguard">
        <taskdef name="yguard" classname="com.yworks.yguard.YGuardTask" classpath="${yguard.jar}"/>
        
        <yguard>
            <inoutpair in="${input.jar}" out="${output.jar}"/>
            
            <rename mainclass="org.omhvn.solarworth.SolarWorth" 
                    logfile="${basedir}/obfuscation/output/yguard-rename.log">
                
                <property name="naming-scheme" value="mix"/>
                <property name="language-conformity" value="compatible"/>
                <property name="overload-enabled" value="true"/>
                <property name="digests" value="MD5"/>
                <property name="scramble" value="true"/>
                
                <keep>
                    <class classes="public" methods="public" fields="none">
                        <patternset>
                            <include name="org.omhvn.solarworth.SolarWorth"/>
                        </patternset>
                    </class>
                    
                    <class classes="private" methods="private" fields="private">
                        <patternset>
                            <include name="org.omhvn.solarworth.SolarWorthExpansion"/>
                        </patternset>
                    </class>
                    
                    <method name="void onEnable()" class="org.omhvn.solarworth.SolarWorth"/>
                    <method name="void onDisable()" class="org.omhvn.solarworth.SolarWorth"/>
                    <method name="void onLoad()" class="org.omhvn.solarworth.SolarWorth"/>
                    
                    <method name="boolean onCommand(org.bukkit.command.CommandSender, org.bukkit.command.Command, java.lang.String, java.lang.String[])">
                        <patternset>
                            <include name="org.omhvn.solarworth.*Command"/>
                        </patternset>
                    </method>
                    
                    <class implements="org.bukkit.event.Listener" methods="public" fields="none"/>
                </keep>
            </rename>
        </yguard>
    </target>
</project>
